# Supabase project in Singapore. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_TOKEN_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional tracking. IDs are public; consent is required before scripts load.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# false by default; true enables local verification only, never preview tracking.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional server-only GA4 reporting (GA_PROPERTY_ID is numeric, not the G- tag).
# Enable Google Analytics Data API and grant this service account Viewer on GA4.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
# PEM private key; escaped \n separators are supported. Never use NEXT_PUBLIC_.
GA_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional short-lived analytics.readonly token for diagnostics; service account preferred.
GA_ACCESS_TOKEN=
